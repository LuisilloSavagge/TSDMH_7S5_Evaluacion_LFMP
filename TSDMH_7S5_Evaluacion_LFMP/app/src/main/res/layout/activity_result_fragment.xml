<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal|center_vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvEstadoSeleccion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mostrando Fragmento de la Selección..."
        android:textSize="14sp"
        android:textColor="#555555"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:drawable/dialog_holo_light_frame"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FRAGMENTO DE DETALLE"
            android:textStyle="bold"
            android:textSize="15sp"
            android:gravity="center"
            android:layout_marginBottom="12dp"
            android:textColor="#222222"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/tvListaResultados"
            android:text="• Bolígrafo Azul - $1.50\n• Cuaderno A4 - $4.00\n• Marcadores Color - $12.00\n• Marcadores A - $4.00\n• Cuaderno A#2 - $4.00\n• CuadernoBolígrafo Azul - $11.50"
            android:textSize="14sp"
            android:textColor="#333333"
            android:lineSpacingExtra="8dp"/>
    </LinearLayout>

</LinearLayout>